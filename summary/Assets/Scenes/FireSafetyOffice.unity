  m_Script: {fileID: 11500000, guid: eea995659c519444c872be64f74a7dc8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FireSafety.ExtinguisherQuizPanel
  questions:
  - question: "\u4F7F\u7528\u5E72\u7C89\u706D\u706B\u5668\u706D\u706B\u65F6\uFF0C\u4EBA\u5E94\u8BE5\u7AD9\u5728\u706B\u7130\u7684\u54EA\u4E2A\u65B9\u5411\uFF1F"
    options:
    - "\u4E0B\u98CE\u65B9\u5411"
    - "\u4E0A\u98CE\uFF08\u6216\u4FA7\u4E0A\u98CE\uFF09\u65B9\u5411"
    - "\u6B63\u5BF9\u706B\u7130\uFF0C\u7AD9\u54EA\u90FD\u4E00\u6837"
    correctIndex: 1
    explanation: "\u5E94\u7AD9\u5728\u4E0A\u98CE\u6216\u4FA7\u4E0A\u98CE\u65B9\u5411\uFF0C\u907F\u514D\u706B\u7130\u548C\u9AD8\u6E29\u70DF\u6C14\u6251\u5411\u81EA\u5DF1\u3002"
  - question: "\u55B7\u5C04\u706D\u706B\u5242\u65F6\uFF0C\u55B7\u7BA1\u5E94\u8BE5\u5BF9\u51C6\u706B\u7130\u7684\u54EA\u4E2A\u90E8\u4F4D\uFF1F"
    options:
    - "\u706B\u7130\u9876\u7AEF"
    - "\u706B\u7130\u4E2D\u90E8"
    - "\u706B\u7130\u6839\u90E8"
    correctIndex: 2
    explanation: "\u706B\u7130\u6839\u90E8\u624D\u662F\u71C3\u70E7\u53CD\u5E94\u53D1\u751F\u7684\u6838\u5FC3\uFF0C\u5BF9\u51C6\u6839\u90E8\u626B\u5C04\u624D\u80FD\u6709\u6548\u6251\u706D\u3002"
  - question: "\u624B\u63D0\u5F0F\u5E72\u7C89\u706D\u706B\u5668\u7684\u538B\u529B\u8868\u6307\u9488\uFF0C\u6307\u5728\u54EA\u4E2A\u533A\u57DF\u8868\u793A\u538B\u529B\u6B63\u5E38\u53EF\u7528\uFF1F"
    options:
    - "\u7EA2\u8272\u533A\u57DF"
    - "\u7EFF\u8272\u533A\u57DF"
    - "\u9EC4\u8272\u533A\u57DF"
    correctIndex: 1
    explanation: "\u7EFF\u533A\u538B\u529B\u6B63\u5E38\uFF1B\u7EA2\u533A\u538B\u529B\u4E0D\u8DB3\uFF1B\u9EC4\u533A\u538B\u529B\u504F\u9AD8\u3002"
  - question: "\u706D\u706B\u5668\u7684\u6807\u51C6\u64CD\u4F5C\u53E3\u8BC0\u662F\u300C\u63D0\u3001\u62D4\u3001\u63E1\u3001\u538B\u300D\uFF0C\u5176\u4E2D\u300C\u62D4\u300D\u6307\u7684\u662F\uFF1F"
    options:
    - "\u62D4\u51FA\u4FDD\u9669\u9500"
    - "\u62D4\u4E0B\u55B7\u7BA1"
    - "\u62D4\u5F00\u538B\u529B\u8868"
    correctIndex: 0
    explanation: "\u63D0\u8D77\u706D\u706B\u5668\u6447\u5300 \u2192 \u62D4\u51FA\u4FDD\u9669\u9500 \u2192 \u63E1\u4F4F\u55B7\u7BA1\u5BF9\u51C6\u706B\u7130\u6839\u90E8 \u2192 \u538B\u4E0B\u538B\u628A\u3002"
  - question: "\u5E72\u7C89\u706D\u706B\u5668\u901A\u5E38\u4E0D\u9002\u7528\u4E8E\u6251\u6551\u4E0B\u5217\u54EA\u7C7B\u706B\u707E\uFF1F"
    options:
    - "\u6728\u6750\u3001\u7EB8\u5F20\u7B49\u56FA\u4F53\u706B\u707E"
    - "\u6C7D\u6CB9\u3001\u67F4\u6CB9\u7B49\u6DB2\u4F53\u706B\u707E"
    - "\u94BE\u3001\u94A0\u7B49\u6D3B\u6CFC\u91D1\u5C5E\u706B\u707E"
    correctIndex: 2
    explanation: "\u94BE\u3001\u94A0\u7B49\u91D1\u5C5E\u706B\u707E\u5C5E D \u7C7B\u706B\u707E\uFF0C\u5FC5\u987B\u4F7F\u7528\u4E13\u7528\u91D1\u5C5E\u706B\u707E\u706D\u706B\u5242\uFF0C\u666E\u901A\u5E72\u7C89\u4E0D\u9002\u7528\u3002"
  timePerQuestion: 10
