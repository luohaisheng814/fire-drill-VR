  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FireSafety.StartScreen
  title: "\u529E\u516C\u5BA4\u6D88\u9632\u77E5\u8BC6\u6F14\u7EC3"
  instructions: "\u73A9\u6CD5\u8BF4\u660E\uFF1A\n\u2460 \u70B9\u51FB\u300C\u5F00\u59CB\u6F14\u7EC3\u300D\u2192 \u8B66\u62A5\u54CD\u8D77\uFF0C\u5012\u8BA1\u65F6\u5F00\u59CB\uFF08\u4E0A\u9650 3 \u5206\u949F\uFF09\uFF1B\n\u2461 \u627E\u5230\u7EA2\u8272\u706D\u706B\u5668\uFF1A\u8FDB\u5165\u89C6\u7EBF\u4F1A\u9AD8\u4EAE\u63D0\u793A\uFF0C\u5730\u9762\u7BAD\u5934\u6307\u5411\u5B83\u7684\u4F4D\u7F6E\uFF1B\n\u2462 \u9F20\u6807\u53F3\u952E\u5355\u51FB\u706D\u706B\u5668 \u2192 \u5F39\u51FA 5 \u9053\u5E38\u8BC6\u9898\uFF0C\u6BCF\u9898 10 \u79D2\uFF0C\u7B54\u5BF9 60%\uFF083 \u9898\uFF09\u624D\u80FD\u62FF\u8D77\uFF1B\n\u2463 \u62FF\u8D77\u540E\uFF1A\u5DE6\u952E\u5355\u51FB\u62D4\u9500 \u2192 \u5DE6\u952E\u53CC\u51FB\u538B\u628A \u2192 \u53F3\u952E\u53CC\u51FB\u55B7\u5C04\uFF0C\u706B\u7130 2~3 \u79D2\u7184\u706D\u5373\u5B8C\u6210\u9636\u6BB5\u4E00\uFF1B\n\u2464 \u9636\u6BB5\u4E00\u5B8C\u6210\u540E\u5012\u8BA1\u65F6\u6682\u505C\uFF0C\u53EF\u9009\u62E9\u300C\u7ACB\u523B\u7ED3\u7B97\u300D\u6216\u300C\u7EE7\u7EED\u5F80\u4E0B\u300D\u3002\n\u952E\u76D8\uFF1AP \u653E\u4E0B\u706D\u706B\u5668\uFF1B\u56DE\u8F66 / \u7A7A\u683C \u5F00\u59CB\u6F14\u7EC3\uFF1B\u95EE\u7B54\u65F6\u6309 1 / 2 / 3 \u4F5C\u7B54\u3002"
  buttonLabel: "\u5F00\u59CB\u6F14\u7EC3"
  worldPosition: {x: 0, y: 1.3, z: 1.8}
  canvasScale: 0.001
  startAlarmOnBegin: 1
  switchBgmToAlarm: 1
  igniteFiresOnBegin: 1
  panelFadeIn: 0.35
  panelScaleIn: 0.45
  titlePulseAmplitude: 0.035
  titlePulseFrequency: 1.1
  buttonPulseAmplitude: 0.03
  buttonPulseFrequency: 1.6
